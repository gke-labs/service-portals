set -o errexit
set -o nounset
set -o pipefail

NAMESPACE="service-portal-system"
CONFIGMAP_NAME="service-portal-config"
AUDIENCE=""
AUDIENCE_SET=false
NODE_AGENT_ACCOUNT=""
NODE_AGENT_ACCOUNT_SET=false
CLIENT_ALLOWLIST=""
CLIENT_ALLOWLIST_SET=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --audience=*)
      AUDIENCE="${1#*=}"
      AUDIENCE_SET=true
      shift
      ;;
    --audience)
      AUDIENCE="$2"
      AUDIENCE_SET=true
      shift 2
      ;;
    --node-agent-account=*)
      NODE_AGENT_ACCOUNT="${1#*=}"
      NODE_AGENT_ACCOUNT_SET=true
      shift
      ;;
    --node-agent-account)
      NODE_AGENT_ACCOUNT="$2"
      NODE_AGENT_ACCOUNT_SET=true
      shift 2
      ;;
    --client-allowlist=*)
      CLIENT_ALLOWLIST="${1#*=}"
      CLIENT_ALLOWLIST_SET=true
      shift
      ;;
    --client-allowlist)
      CLIENT_ALLOWLIST="$2"
      CLIENT_ALLOWLIST_SET=true
      shift 2
      ;;
    -n|--namespace)
      NAMESPACE="$2"
      shift 2
      ;;
    --namespace=*)
      NAMESPACE="${1#*=}"
      shift
      ;;
    -h|--help)
      echo "Usage: $0 [options]"
      echo "Creates the service-portal configuration ConfigMap after deploying the controller manifest."
      echo ""
      echo "Options:"
      echo "  --audience <aud>             TokenReview audience (default: https://service-portal-controller, matching k8s/node-agent.yaml)"
      echo "  --node-agent-account <sa>    Node agent service account (default: system:serviceaccount:<namespace>:portal-node-agent, matching k8s/node-agent.yaml)"
      echo "  --client-allowlist <sa,...>  Comma-separated list of permitted client service accounts"
      echo "  -n, --namespace <ns>         Namespace for ConfigMap (default: service-portal-system)"
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

if [[ "${AUDIENCE_SET}" != "true" ]]; then
  # Fixed audience matching k8s/node-agent.yaml.
  AUDIENCE="https://service-portal-controller"
  echo "Using default audience: ${AUDIENCE}"
fi

if [[ "${NODE_AGENT_ACCOUNT_SET}" != "true" ]]; then
  NODE_AGENT_ACCOUNT="system:serviceaccount:${NAMESPACE}:portal-node-agent"
  echo "Using default node agent account: ${NODE_AGENT_ACCOUNT}"
fi

if [[ "${CLIENT_ALLOWLIST_SET}" != "true" ]]; then
  CLIENT_ALLOWLIST=""
  echo "Using default client allowlist: '' (all client calls will be refused)"
fi

echo "Creating ConfigMap '${CONFIGMAP_NAME}' in namespace '${NAMESPACE}'..."
kubectl create configmap "${CONFIGMAP_NAME}" \
  --namespace="${NAMESPACE}" \
  --from-literal=audience="${AUDIENCE}" \
  --from-literal=node-agent-account="${NODE_AGENT_ACCOUNT}" \
  --from-literal=client-allowlist="${CLIENT_ALLOWLIST}" \
  --dry-run=client -o yaml | kubectl apply -f -
